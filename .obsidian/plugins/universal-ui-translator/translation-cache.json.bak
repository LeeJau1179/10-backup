    "e3efe5936dca534e": {
      "src": ": When you explicitly Host or synchronize a Collab Project, Project Git data and authenticated coordination metadata travel directly between invited teammates' devices on the local network. Collab Mode itself does not send Project data to a Claudian cloud service or any third party.",
      "tgt": "当您明确托管或同步协作项目时，项目 Git 数据和经过身份验证的协调元数据会直接在受邀队友的本地网络设备之间传输。协作模式本身不会将项目数据发送到 Claudian 云服务或任何第三方。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789139575196
    },
    "17575a7e87cc97e3": {
      "src": "No telemetry or unsolicited background activity",
      "tgt": "无遥测或未经请求的后台活动",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789139575196
    },
    "41bdad8308f9edb3": {
      "src": ": Claudian does not run telemetry beacons. UI polling timers read local Obsidian/editor selection state only. Network activity is limited to explicit provider runtime work, configured MCP endpoints, provider SDK/CLI calls needed to answer your requests, and explicitly started Collab LAN work.",
      "tgt": "Claudian 不运行遥测信标。UI 轮询计时器仅读取本地 Obsidian/编辑器选择状态。网络活动仅限于显式的提供程序运行时工作、已配置的 MCP 端点、为响应您的请求所需的提供程序 SDK/CLI 调用，以及显式启动的 Collab LAN 工作。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789139575196
    },
    "afb81fab246d11e8": {
      "src": "The following sections use Claude Code as an example.",
      "tgt": "以下部分以 Claude Code 为例。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789139575196
    },
