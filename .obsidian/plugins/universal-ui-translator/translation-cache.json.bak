    "8b608dfa1fdbd1e3": {
      "src": "Issue #73 — when on, scene fields like pov, location, characters, setup_scenes and payoff_scenes are stored as Obsidian [[wikilinks]] so they auto-update on rename. Existing plain-text values keep working.",
      "tgt": "问题 #73 — 开启后，pov、location、characters、setup_scenes 和 payoff_scenes 等场景字段将以 Obsidian [[wikilinks]] 形式存储，以便在重命名时自动更新。现有的纯文本值仍可正常使用。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "3ec96a760bc015f3": {
      "src": "Sort suggestions by frequency",
      "tgt": "按频率排序建议",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "a7180f5d9a9ab22e": {
      "src": "When on, character and location suggestions in the scene inspector are sorted by how often they appear across scenes (most used first), then alphabetically. Off = alphabetical only. (Issue #238 feedback.)",
      "tgt": "开启时，场景检查器中的角色和地点建议将按其在各场景中出现的频率排序（最常用的在前），然后按字母顺序排列。关闭时仅按字母顺序排列。（问题 #238 反馈。）",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "1cfaf65ea6a6ceeb": {
      "src": "Mirror custom fields to top-level YAML",
      "tgt": "将自定义字段镜像到顶层 YAML",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "ef67f44a6e48047d": {
      "src": "Issue #71 — when on, universal field values are also written as top-level YAML keys (using each template's \"top-level key\") so they show up in Obsidian properties, bases, and dataview. Reserved StoryLine keys are skipped automatically.",
      "tgt": "问题 #71 — 开启后，通用字段值也会作为顶层 YAML 键写入（使用各模板的“顶层键”），以便在 Obsidian 属性、Bases 和 Dataview 中显示。保留的 StoryLine 键会自动跳过。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "cd84ee761b922c10": {
      "src": "Count unit for scene lengths",
      "tgt": "场景长度计数单位",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "438449178ccd6615": {
      "src": "Choose whether scene cards, the timeline, and the inspector display scene length in words or characters. Useful for prose writers who track length in characters (e.g. Russian, chinese, japanese).",
      "tgt": "选择场景卡片、时间线和检查器以字数还是字符数显示场景长度。适用于以字符数跟踪篇幅的散文作者（如俄语、中文、日语）。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "72b1f141b7f802a2": {
      "src": "Exclude `%%comments%%` from wordcount",
      "tgt": "将 `%%comments%%` 排除在字数统计之外",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "ecbc02e38ed4c907": {
      "src": "Issue #78 — strip Obsidian comment blocks (anything between `%%` markers) before counting words. Keeps `wordcount` aligned with what readers will actually see.",
      "tgt": "问题 #78 — 在统计字数前剥离 Obsidian 注释块（`%%` 标记之间的所有内容）。使 `wordcount` 与读者实际看到的内容保持一致。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "b9a5f38a7261b713": {
      "src": "Also ignore checkbox lines (`- [ ]`, `- [x]`)",
      "tgt": "同时忽略复选框行（`- [ ]`、`- [x]`）",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
    "33e1b786688ba75e": {
      "src": "Issue #78 — also drop markdown task lines from the wordcount. Off by default because some authors keep checklists in the manuscript body.",
      "tgt": "问题 #78 — 同时从字数统计中排除 Markdown 任务行。默认关闭，因为有些作者会在稿件正文中保留清单。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
