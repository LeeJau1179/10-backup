    "74b3b32cfdf5594e": {
      "src": "BCP-47 tag used for word counting, reading time, dialogue %, stop-word filtering and PDF line wrapping. Choose Auto-detect to infer the script from manuscript text. Existing projects that still use the old default are updated too; otherwise set per-project by editing `language:` in the project frontmatter.",
      "tgt": "用于字数统计、阅读时间、对话占比、停用词过滤和PDF换行的BCP-47标签。选择“自动检测”可从稿件文本推断文字系统。仍使用旧默认值的现有项目也会被更新；否则可通过编辑项目frontmatter中的`language:`按项目设置。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477387815
    },
