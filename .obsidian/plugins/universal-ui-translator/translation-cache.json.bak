    },
    "5e8c0018e0ebaec4": {
      "src": "Custom base path (Git repository path)",
      "tgt": "自定义基础路径（Git 仓库路径）",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345698
    },
    "e3de21a8beffc9c8": {
      "src": "Sets the relative path to the vault from which the Git binary should be executed.\n             Mostly used to set the path to the Git repository, which is only required if the Git repository is below the vault root directory. Use \"\\\" instead of \"/\" on Windows.",
      "tgt": "设置执行 Git 二进制文件时相对于仓库的路径。\n主要用于设置 Git 仓库的路径，仅在 Git 仓库位于仓库根目录之下时才需要。在 Windows 上请使用“\\”而非“/”。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345698
    },
    "a07e3aa232a34b4c": {
      "src": "Custom Git directory path (Instead of '.git')",
      "tgt": "自定义 Git 目录路径（替代“.git”）",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345698
    },
    "6675d25e9cfd57a9": {
      "src": "Corresponds to the GIT_DIR environment variable. Relative paths are resolved from the custom base path, or the vault root when no base path is configured. Requires restart of Obsidian to take effect. Use \"\\\" instead of \"/\" on Windows.",
      "tgt": "对应 GIT_DIR 环境变量。相对路径基于自定义基础路径解析，未配置基础路径时基于仓库根目录解析。需重启 Obsidian 生效。Windows 上请使用“\\”而非“/”。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345698
    },
    "1d186d6f971cff0a": {
