    "42d1af728eaf7bf0": {
      "src": "Squash commits before push",
      "tgt": "推送前压缩提交",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345473
    },
    "f502aa8e71891826": {
      "src": "On commit-and-sync, squash all local unpushed commits into a single commit right before pushing. Keeps the remote history clean when committing often. Only unpushed commits are rewritten, so no force-push is needed.",
      "tgt": "提交并同步时，在推送前将所有未推送的本地提交压缩为单个提交。频繁提交时保持远程历史整洁。仅重写未推送的提交，因此无需强制推送。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345473
    },
    "bb6c73149d13d255": {
      "src": "Hunk management",
      "tgt": "代码块管理",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345473
    },
    "1afcc6bd80656021": {
      "src": "Hunks are sections of grouped line changes right in your editor.",
      "tgt": "代码块是编辑器中分组行更改的部分。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345473
    },
