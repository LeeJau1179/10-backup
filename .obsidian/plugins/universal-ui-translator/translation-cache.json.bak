    "42dd30bdc26be6eb": {
      "src": "Commit-and-sync",
      "tgt": "提交并同步",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345473
    },
    "6923cf7894ced5ef": {
      "src": "Commit-and-sync with default settings means staging everything -> committing -> pulling -> pushing. Ideally this is a single action that you do regularly to keep your local and remote repository in sync.",
      "tgt": "使用默认设置提交并同步意味着暂存所有内容 -> 提交 -> 拉取 -> 推送。理想情况下，这是您定期执行的单一操作，以保持本地和远程仓库同步。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
