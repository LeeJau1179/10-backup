      "hits": 1,
      "updatedAt": 1789139627699
    },
    "071d011ad8955f6a": {
      "src": "Extract the full text of a PDF as Markdown using Copilot Plus. Use when the user wants to read, summarize, or quote a PDF file (in the vault or an absolute path). Requires an active Copilot Plus license.",
      "tgt": "使用 Copilot Plus 将 PDF 全文提取为 Markdown。当用户想要阅读、总结或引用 PDF 文件（库内或绝对路径）时使用。需要有效的 Copilot Plus 许可证。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 1,
      "updatedAt": 1789139627699
    },
    "4058f47c45a061e1": {
      "src": "Fetch and read the full contents of a specific web page (URL) as clean Markdown using Copilot Plus. Use when the user shares a link or asks you to open, read, or summarize a particular page — not for an open-ended web search. Requires an active Copilot Plus license; without it, use your own fetch tool instead.",
      "tgt": "使用 Copilot Plus 获取并读取特定网页（URL）的完整内容，以干净的 Markdown 格式呈现。当用户分享链接或要求你打开、阅读或总结某个特定页面时使用——不适用于开放式的网络搜索。需要有效的 Copilot Plus 许可证；如果没有，请改用你自己的抓取工具。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 1,
      "updatedAt": 1789139627699
    },
    "eb0e7fa88b9fad6e": {
      "src": "Search the web for current information using Copilot Plus or the configured Self-Host search provider. Use when the user asks to search online, look something up on the internet, or needs up-to-date facts beyond the vault. Prefer reading the vault for anything about the user's own notes.",
      "tgt": "使用 Copilot Plus 或已配置的自托管搜索提供商搜索网络获取最新信息。当用户要求在线搜索、在互联网上查找内容，或需要库之外的最新事实时使用。对于用户自己的笔记相关内容，优先阅读库。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 1,
      "updatedAt": 1789139627699
    },
    "73e0b056289ef364": {
      "src": "Fetch the transcript of a YouTube video using Copilot Plus. Use when the user shares a YouTube URL and wants its contents, a summary, or quotes. Requires an active Copilot Plus license.",
      "tgt": "使用 Copilot Plus 获取 YouTube 视频字幕。当用户分享 YouTube 链接并希望获取内容、摘要或引用时使用。需要有效的 Copilot Plus 许可证。",
