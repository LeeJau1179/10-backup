      "updatedAt": 1789139627699
    },
    "bd02db83e421b438": {
      "src": "Create and edit JSON Canvas (.canvas) files with valid nodes, edges, groups, colors, layout, IDs, and referential integrity. Use for Obsidian Canvas files, visual maps, flowcharts, project boards, or any request involving the JSON Canvas format.",
      "tgt": "创建和编辑 JSON Canvas (.canvas) 文件，包含有效的节点、边、分组、颜色、布局、ID 和引用完整性。适用于 Obsidian Canvas 文件、可视化地图、流程图、项目看板，或任何涉及 JSON Canvas 格式的请求。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 1,
      "updatedAt": 1789139627699
    },
    "381d5f360299d71f": {
      "src": "Create and edit Obsidian Bases (.base files) with valid YAML schemas, filters, formulas, properties, summaries, and views. Use for database-like Obsidian views or when the user mentions Bases, .base files, table/card/list views, filters, formulas, or summaries.",
      "tgt": "创建和编辑 Obsidian Bases（.base 文件），包含有效的 YAML 模式、过滤器、公式、属性、摘要和视图。用于数据库式的 Obsidian 视图，或当用户提到 Bases、.base 文件、表格/卡片/列表视图、过滤器、公式或摘要时使用。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 1,
      "updatedAt": 1789139627699
    },
    "d691129bafbf9943": {
      "src": "Use the official Obsidian CLI when a task needs Obsidian's running app, index, configured features, command registry, or developer runtime. Use for currently open notes and tabs, workspace state, daily notes, typed properties, tasks, links/backlinks, Bases queries, template resolution, link-aware moves, plugin commands, and plugin/theme debugging; do not use it for ordinary filesystem operations.",
      "tgt": "当任务需要 Obsidian 运行中的应用、索引、已配置功能、命令注册表或开发者运行时，请使用官方 Obsidian CLI。适用于当前打开的笔记和标签页、工作区状态、每日笔记、类型化属性、任务、链接/反向链接、Bases 查询、模板解析、链接感知移动、插件命令以及插件/主题调试；请勿将其用于普通文件系统操作。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 1,
      "updatedAt": 1789139627699
    },
    "0f3abcbfe6f6b7e2": {
      "src": "Create and edit Obsidian-specific Markdown syntax, including wikilinks, embeds, block references, callouts, properties, tags, and comments. Use for Obsidian notes when these extensions matter; ordinary Markdown is assumed knowledge.",
      "tgt": "创建和编辑 Obsidian 专属 Markdown 语法，包括双链、嵌入、块引用、标注、属性、标签和注释。用于需要这些扩展功能的 Obsidian 笔记；普通 Markdown 视为已知知识。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 1,
      "updatedAt": 1789139627699
    },
    "51854d486a9771aa": {
