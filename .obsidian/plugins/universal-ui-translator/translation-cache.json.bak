    "d50d7e26f83d4b0f": {
      "src": "Delay for initial automatic application of custom ordering",
      "tgt": "延迟初始自动应用自定义排序",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477345760
    },
    "c4f2c5c2129e8ad0": {
      "src": "Number of seconds to wait before applying custom ordering on plugin / app start.",
      "tgt": "插件/应用启动后应用自定义排序前等待的秒数。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477345760
    },
    "42807ee456143dc0": {
      "src": "For large vaults, multi-plugin vaults or on mobile the value might need to be increased if you encounter issues with auto-applying of custom ordering on start. The delay gives Obsidian additional time to sync notes from cloud storages, to populate notes metadata caches, etc.",
      "tgt": "对于大型仓库、多插件仓库或移动端，如果在启动时自动应用自定义排序遇到问题，可能需要增大该值。该延迟为 Obsidian 提供了额外时间，用于从云存储同步笔记、填充笔记元数据缓存等。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477345760
    },
    "215dfb8a806b310d": {
      "src": "At the same time if your vault is relatively small or only used on desktop, or not synced with other copies, decreasing the delay to 0 could be a safe option.",
      "tgt": "同时，如果你的库相对较小或仅在桌面端使用，或未与其他副本同步，将延迟降低到0可能是一个安全的选择。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477345760
    },
    "916a8b8f6b9a1e31": {
      "src": "Min: 0 sec., max. 30 sec.",
      "tgt": "最短：0秒，最长：30秒",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477345760
    },
