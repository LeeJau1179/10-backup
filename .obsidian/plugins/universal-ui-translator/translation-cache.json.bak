    "5544e87c62984fc2": {
      "src": "An Obsidian plugin that embeds AI coding agents (Claude Code, Codex, Grok, Opencode, Pi, and more to come) in your vault. Your vault becomes the agent's working directory — file read/write, search, bash, and multi-step workflows all work out of the box. Visit",
      "tgt": "一个 Obsidian 插件，将 AI 编程代理（Claude Code、Codex、Grok、Opencode、Pi 等更多即将推出）嵌入你的库中。你的库将成为代理的工作目录——文件读写、搜索、bash 和多步骤工作流均可开箱即用。访问",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789139574584
    },
    "2d0b464e112ba0bf": {
      "src": "to learn more.",
      "tgt": "了解更多",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789139574584
    },
    "2f3f7effba21735b": {
      "src": "Features & Usage",
      "tgt": "功能与用法",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789139574584
    },
    "d5b1af3b3d278583": {
      "src": "Open the chat sidebar from the ribbon icon or command palette. Select text and use the shortcut for inline editing. Everything works like your familiar coding agent, Claude Code, Codex, Grok, Opencode, and Pi — talk to the agent, and it reads, writes, edits, and searches files in your vault.",
      "tgt": "从功能区图标或命令面板打开聊天侧边栏。选中文本并使用快捷键进行行内编辑。一切操作都像你熟悉的编码代理一样——Claude Code、Codex、Grok、Opencode 和 Pi——与代理对话，它就能读取、写入、编辑和搜索你库中的文件。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789139574584
    },
