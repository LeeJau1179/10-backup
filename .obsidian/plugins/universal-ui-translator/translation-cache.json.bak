      "from": "unknown@",
      "hits": 3,
      "updatedAt": 1789477345698
    },
    "e2988fe16f06fe48": {
      "src": "Specify the path to the Git binary/executable. Git should already be in your PATH. Should only be necessary for a custom Git installation.",
      "tgt": "指定 Git 可执行文件的路径。Git 应已在 PATH 中。仅在自定义安装时需要。",
      "provider": "openai",
      "lang": "zh-CN",
