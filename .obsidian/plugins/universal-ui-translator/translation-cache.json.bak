    "0766e2c2f731db73": {
      "src": "Messages and note context go to the LLM provider, local endpoint, or CLI agent you configure. Brevilabs does not receive them unless you invoke a Brevilabs-hosted feature.",
      "tgt": "消息和笔记上下文会发送至您配置的LLM提供商、本地端点或CLI代理。除非您调用Brevilabs托管的功能，否则Brevilabs不会接收这些内容。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 4,
      "updatedAt": 1789139453474
    },
    "eed451d4da937967": {
      "src": "Paid hosted services:",
      "tgt": "付费托管服务：",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 4,
      "updatedAt": 1789139453474
    },
    "9484b07832847efe": {
      "src": "Brevilabs's backend and its vetted enterprise model providers process the full request. Hosted features receive the inputs they need, such as search queries, URLs, and files used by Quick Chat tools or Agent project context. The privacy policy says request content is processed transiently, not retained, and not used for training.",
      "tgt": "Brevilabs 的后端及其经过审核的企业模型提供商处理完整请求。托管功能会接收其所需的输入，例如搜索查询、URL 以及 Quick Chat 工具或 Agent 项目上下文使用的文件。隐私政策声明请求内容仅作临时处理，不会被保留，也不会用于训练。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 4,
      "updatedAt": 1789139453474
    },
    "dcb377cd7a140172": {
      "src": "User ID:",
      "tgt": "用户 ID",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 4,
      "updatedAt": 1789139453474
    },
    "4a89323f637df48c": {
      "src": "Hosted feature requests include a randomly generated UUID for service delivery, license abuse prevention, and rate limiting. It is not used for tracking, profiling, or analytics.",
      "tgt": "托管的特性请求包含随机生成的UUID，用于服务交付、防止许可证滥用和速率限制。它不用于跟踪、画像或分析。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 4,
      "updatedAt": 1789139453474
    },
