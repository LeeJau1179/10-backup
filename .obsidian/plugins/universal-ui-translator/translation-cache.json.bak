    "b1dd59ee1903f5a5": {
      "src": "The Copilot plugin is open source and works without a Copilot license when you use your own agent account, provider key, or local model. Free use includes normal single-agent Agent chats, Projects with Markdown context, custom Skills and Commands, Quick Chat, Quick Ask, and local Miyo search.",
      "tgt": "Copilot 插件是开源的，使用自己的代理账户、提供商密钥或本地模型时无需 Copilot 许可证即可使用。免费使用包括常规单代理 Agent 聊天、带 Markdown 上下文的项目、自定义技能和命令、快速聊天、快速提问以及本地 Miyo 搜索。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 4,
      "updatedAt": 1789139466755
    },
    "2bf9bb4fa7b1dcd5": {
      "src": "Paid access can include Copilot-hosted models and cloud-backed tools. Multi-agent requires active Plus access; check your dashboard for the current entitlement. Model availability and service limits can change, so the",
      "tgt": "付费访问可包含 Copilot 托管的模型和云支持工具。多代理功能需要有效的 Plus 订阅；请查看仪表板了解当前权益。模型可用性和服务限制可能随时调整，因此",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 4,
      "updatedAt": 1789139466755
    },
    "874e73dd03078f56": {
      "src": "pricing page",
      "tgt": "定价页面",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 4,
      "updatedAt": 1789139466755
    },
    "f319d281ac471c9b": {
