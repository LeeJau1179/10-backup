    "1905d2edf587bd55": {
      "src": "Most of the time you want to push after committing. Turning this off turns a commit-and-sync action into commit only. It will still be called commit-and-sync.",
      "tgt": "大多数时候你会在提交后推送。关闭此选项会将提交并同步操作变为仅提交。它仍会被称为提交并同步。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477506940
    },
    "a5088cb35d093a69": {
      "src": "On commit-and-sync, pull commits as well. Turning this off turns a commit-and-sync action into commit only.",
      "tgt": "提交并同步时也拉取提交。关闭此选项后，提交并同步操作将仅执行提交。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 1,
      "updatedAt": 1789477460718
    },
