    },
    "d763e5ba4cdef724": {
      "src": "If enabled, order of files and folders in File Explorer will reflect the order of bookmarked items in the bookmarks (core plugin) view. Automatically, without any need for sorting configuration. At the same time, it integrates seamlessly with",
      "tgt": "如果启用，文件资源管理器中文件和文件夹的顺序将反映书签（核心插件）视图中已收藏项目的顺序。自动生效，无需任何排序配置。同时，它与",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789477345760
    },
