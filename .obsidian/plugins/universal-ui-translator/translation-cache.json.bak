    "ee171743aefa3716": {
      "src": "The two heroes meet for the first time — memorable, sparky, and hinting at why they might be perfect for each other (and why now is not the time).",
      "tgt": "两位英雄初次相遇——令人难忘，火花四溅，并暗示了他们为何可能是彼此的完美搭档（以及为何现在还不是时候）。",
      "provider": "openai",
      "lang": "zh-CN",
      "from": "unknown@",
      "hits": 0,
      "updatedAt": 1789198523970
    },
    "d968eed161f6d151": {
      "src": "No Way #1",
      "tgt": "无路 #1",
